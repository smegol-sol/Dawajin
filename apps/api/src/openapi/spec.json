{
  "openapi": "3.1.0",
  "info": {
    "title": "Dawajin API",
    "version": "0.0.1",
    "description": "المصدر الوحيد لعقد الـ API (backend-technical-spec.md §18). كل مسار تحت /api يجب أن يُوثَّق هنا — الفاحص الآلي (scripts/checks/openapi-coverage.ts) يفشل البناء عند أي فرق."
  },
  "paths": {
    "/api/settings": {
      "get": {
        "summary": "قراءة إعدادات المستأجر التشغيلية",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "الإعدادات الحالية",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantSettings"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "patch": {
        "summary": "تحديث إعدادات المستأجر التشغيلية (owner فقط)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TenantSettingsUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "الإعدادات بعد التحديث",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantSettings"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "TenantSettings": {
        "type": "object",
        "properties": {
          "feedBagWeightKg": {
            "type": "number"
          },
          "feedStarterEndDay": {
            "type": "integer"
          },
          "feedGrowerEndDay": {
            "type": "integer"
          },
          "feedAnomalyThresholdPct": {
            "type": "integer"
          },
          "feedLowStockThresholdDays": {
            "type": "integer"
          },
          "minRestDays": {
            "type": "integer"
          }
        }
      },
      "TenantSettingsUpdate": {
        "type": "object",
        "description": "أي مجموعة فرعية من TenantSettings — يجب حقل واحد على الأقل",
        "properties": {
          "feedBagWeightKg": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "feedStarterEndDay": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "feedGrowerEndDay": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "feedAnomalyThresholdPct": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "feedLowStockThresholdDays": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "minRestDays": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "description": "عربية جاهزة للعرض دائمًا"
          },
          "details": {}
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "بيانات غير صالحة",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "غير مصادَق",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "غير مخوَّل",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotFound": {
        "description": "غير موجود",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  }
}
