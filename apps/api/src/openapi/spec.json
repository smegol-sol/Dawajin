{
  "openapi": "3.1.0",
  "info": {
    "title": "Dawajin API",
    "version": "0.0.1",
    "description": "المصدر الوحيد لعقد الـ API (backend-technical-spec.md §18). كل مسار تحت /api يجب أن يُوثَّق هنا — الفاحص الآلي (scripts/checks/openapi-coverage.ts) يفشل البناء عند أي فرق."
  },
  "paths": {
    "/api/auth/accounts": {
      "post": {
        "summary": "حسابات رقم جوال — الخطوة الأولى في تسجيل الدخول",
        "description": "يعيد المستأجرين الذين لهذا الرقم حساب **نشط** لديهم، بلا كلمة مرور وبلا بيانات شخصية (القرار #106). الحسابات المعطَّلة تُخفى (القيد د). حدّ 3 طلبات/دقيقة — أشدّ من حدّ الدخول لأن الطلب أرخص (بلا bcrypt) فأنفع للتعداد (القيد ج).",
        "tags": ["auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountsRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "قائمة الحسابات النشطة (قد تكون فارغة)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountsResponse"
                }
              }
            }
          },
          "400": {
            "description": "بيانات غير صالحة",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "تجاوز حدّ المحاولات",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "summary": "تسجيل الدخول برقم الجوال وكلمة المرور — بلا مصادقة مسبقة",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "نجاح — رمز وملف المستخدم",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginSuccess"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "رقم الجوال أو كلمة المرور غير صحيحة",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "كلمة المرور صحيحة والحساب معطَّل — يُميَّز بعد المطابقة حصرًا (decisions.md #84)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "429": {
            "description": "محاولات كثيرة — حاول بعد دقيقة"
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "summary": "بيانات المستخدم الحالي",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "بيانات المستخدم",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/auth/change-password": {
      "post": {
        "summary": "تغيير كلمة مرور المستخدم الحالي",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChangePasswordRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "تم التغيير"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "description": "غير مصادَق، أو كلمة المرور الحالية غير صحيحة",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/auth/register-push-token": {
      "post": {
        "summary": "تسجيل رمز الإشعارات (Expo push token) للمستخدم الحالي",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterPushTokenRequest"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "تم التسجيل"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/settings": {
      "get": {
        "summary": "قراءة إعدادات المستأجر التشغيلية",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "الإعدادات الحالية",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantSettings"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "patch": {
        "summary": "تحديث إعدادات المستأجر التشغيلية (owner فقط)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TenantSettingsUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "الإعدادات بعد التحديث",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantSettings"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/sites": {
      "get": {
        "summary": "سرد مواقع المستأجر — كل الأدوار",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "قائمة المواقع مرتّبة بالاسم (قد تكون فارغة)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteListResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "summary": "إنشاء موقع (owner فقط)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SiteWriteRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "الموقع بعد الإنشاء",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Site"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/sites/{siteId}": {
      "get": {
        "summary": "قراءة موقع واحد — كل الأدوار",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "siteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "الموقع",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Site"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "summary": "إعادة تسمية موقع (owner فقط) — الاسم وحده قابل للتعديل",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "siteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SiteWriteRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "الموقع بعد التسمية",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Site"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/sites/{siteId}/farms": {
      "get": {
        "summary": "سرد مزارع موقع — كل الأدوار",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "siteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "مزارع الموقع مرتّبة بالاسم",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FarmListResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "summary": "إنشاء مزرعة تحت موقع (owner فقط)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "siteId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FarmCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "المزرعة بعد الإنشاء",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Farm"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/farms/{farmId}": {
      "get": {
        "summary": "قراءة مزرعة واحدة — كل الأدوار",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "farmId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "المزرعة",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Farm"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "summary": "تعديل مزرعة (owner فقط) — النقل بين المواقع مقيَّد بالقرار #114",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "farmId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FarmUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "المزرعة بعد التعديل",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Farm"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "اسم مكرَّر، أو نقل مزرعة لها عنابر (`farm_has_houses`)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": ["phone", "password", "tenantId"],
        "properties": {
          "phone": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "tenantId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "description": "**إلزامي** (القيد أ، القرار #106) — الحساب المختار من POST /api/auth/accounts. جعله اختياريًا يعيد ثقب #98."
          }
        }
      },
      "LoginSuccess": {
        "type": "object",
        "required": ["token", "user"],
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/CurrentUser"
          }
        }
      },
      "CurrentUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "tenantId": {
            "type": ["integer", "null"]
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "isActive": {
            "type": "boolean"
          },
          "mustChangePassword": {
            "type": "boolean"
          }
        }
      },
      "ChangePasswordRequest": {
        "type": "object",
        "required": ["currentPassword", "newPassword"],
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string",
            "minLength": 8
          }
        }
      },
      "RegisterPushTokenRequest": {
        "type": "object",
        "required": ["expoPushToken"],
        "properties": {
          "expoPushToken": {
            "type": "string"
          }
        }
      },
      "TenantSettings": {
        "type": "object",
        "properties": {
          "feedBagWeightKg": {
            "type": "number"
          },
          "feedStarterEndDay": {
            "type": "integer"
          },
          "feedGrowerEndDay": {
            "type": "integer"
          },
          "feedAnomalyThresholdPct": {
            "type": "integer"
          },
          "feedLowStockThresholdDays": {
            "type": "integer"
          },
          "minRestDays": {
            "type": "integer"
          }
        }
      },
      "TenantSettingsUpdate": {
        "type": "object",
        "description": "أي مجموعة فرعية من TenantSettings — يجب حقل واحد على الأقل",
        "properties": {
          "feedBagWeightKg": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "feedStarterEndDay": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "feedGrowerEndDay": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "feedAnomalyThresholdPct": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "feedLowStockThresholdDays": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "minRestDays": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "description": "عربية جاهزة للعرض دائمًا"
          },
          "details": {}
        }
      },
      "AccountsRequest": {
        "type": "object",
        "required": ["phone"],
        "properties": {
          "phone": {
            "type": "string",
            "description": "رقم الجوال بأي صيغة — الخادم يطبّعه (§11)"
          }
        }
      },
      "AccountsResponse": {
        "type": "object",
        "required": ["accounts"],
        "properties": {
          "accounts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["tenantId", "tenantName"],
              "properties": {
                "tenantId": {
                  "type": "integer",
                  "description": "يُرسَل ولا يُعرَض إطلاقًا (§12)"
                },
                "tenantName": {
                  "type": "string"
                }
              },
              "description": "**بلا اسم أو دور** — لا يُرجَعان قبل التحقق (القيد ب، #106)"
            }
          }
        }
      },
      "Site": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "integer",
            "description": "معرّف داخلي — يُرسَل ولا يُعرَض (§12)"
          },
          "name": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "SiteListResponse": {
        "type": "object",
        "required": ["sites"],
        "properties": {
          "sites": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Site"
            }
          }
        }
      },
      "SiteWriteRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "Farm": {
        "type": "object",
        "required": ["id", "siteId", "name", "powerSources"],
        "properties": {
          "id": {
            "type": "integer"
          },
          "siteId": {
            "type": "integer",
            "description": "الموقع الذي تقع فيه — يُرسَل ولا يُعرَض (§12)"
          },
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "powerSources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["شمسية", "مولدات"]
            },
            "description": "لا مزرعة بلا مصدر طاقة (القرار #112)"
          }
        }
      },
      "FarmListResponse": {
        "type": "object",
        "required": ["farms"],
        "properties": {
          "farms": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Farm"
            }
          }
        }
      },
      "FarmCreateRequest": {
        "type": "object",
        "required": ["name", "powerSources"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
