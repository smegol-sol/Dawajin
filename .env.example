# انظر docs/backend-technical-spec.md الملحق ج للتفصيل الكامل

NODE_ENV=development
PORT=3000

# تحقنها المنصة في الإنتاج — لا تُكتب قيمة إنتاج هنا أبدًا
DATABASE_URL=postgres://dawajin:dawajin_dev_password@localhost:5432/dawajin_dev
TEST_DATABASE_URL=postgres://dawajin:dawajin_dev_password@localhost:5432/dawajin_test

JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=30d
BCRYPT_ROUNDS=10

# كلمة مرور حسابات العرض التي ينشئها `pnpm seed:demo` — للتطوير وحده.
# ليست سرًّا إنتاجيًّا: مستأجر العرض لا يُنشأ إلا في development/test بحارس صريح.
SEED_DEMO_PASSWORD=Dawajin#2026

S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

EXPO_ACCESS_TOKEN=

LOG_LEVEL=debug

DEFAULT_COUNTRY_CODE=+967

# تطبيق الموبايل — يجب أن يشير للخادم المنشور لا localhost في الإنتاج
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_ENV=development
